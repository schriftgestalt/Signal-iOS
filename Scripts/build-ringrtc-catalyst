#!/bin/bash

# SPDX-License-Identifier: AGPL-3.0-only

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly CHECKOUT_ROOT="$(cd "${REPO_ROOT}/.." && pwd)"

readonly RINGRTC_TAG="v2.71.0"
readonly RINGRTC_COMMIT="4c5fdb312d3c0d6b8e4091e4be5271c020f5792d"
readonly WEBRTC_VERSION="7871f"
readonly WEBRTC_COMMIT="3a5cb5f6ea8d223a7b05e4e22ce3f9b77a740f8a"

readonly RINGRTC_DIR="${RINGRTC_DIR:-${CHECKOUT_ROOT}/ringrtc}"
readonly DEPOT_TOOLS_DIR="${DEPOT_TOOLS_DIR:-${CHECKOUT_ROOT}/depot_tools}"
readonly WEBRTC_SRC_DIR="${RINGRTC_DIR}/src/webrtc/src"
readonly WEBRTC_BUILD_DIR="${WEBRTC_SRC_DIR}/out/catalyst-arm64-release"
readonly OUTPUT_DIR="${RINGRTC_DIR}/out/release"
readonly RINGRTC_PATCH="${SCRIPT_DIR}/patches/ringrtc-catalyst.patch"
readonly RUST_TARGET="aarch64-apple-ios-macabi"
readonly DEPLOYMENT_TARGET="15.0"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: missing required command: $1" >&2
    exit 1
  fi
}

clone_if_missing() {
  local url="$1"
  local directory="$2"
  shift 2

  if [[ ! -d "${directory}/.git" ]]; then
    git clone "$@" "${url}" "${directory}"
  fi
}

verify_commit() {
  local directory="$1"
  local expected_commit="$2"
  local actual_commit
  actual_commit="$(git -C "${directory}" rev-parse HEAD)"

  if [[ "${actual_commit}" != "${expected_commit}" ]]; then
    echo "error: ${directory} is at ${actual_commit}; expected ${expected_commit}" >&2
    exit 1
  fi
}

validate_archive() {
  local archive="$1"
  local object_name
  local validation_dir
  local build_info

  object_name="$(ar -t "${archive}" | awk '/\.o$/ && object_name == "" { object_name = $0 } END { print object_name }')"
  if [[ -z "${object_name}" ]]; then
    echo "error: ${archive} does not contain an object file" >&2
    exit 1
  fi

  validation_dir="$(mktemp -d)"
  (
    cd "${validation_dir}"
    ar -x "${archive}" "${object_name}"
    build_info="$(xcrun vtool -show-build "${object_name}")"
    grep -q 'platform MACCATALYST' <<< "${build_info}"
  )
  rm -rf "${validation_dir}"
}

validate_framework() {
  local xcframework="$1"
  local binary="${xcframework}/ios-arm64-maccatalyst/WebRTC.framework/Versions/A/WebRTC"
  local variant
  local build_info

  variant="$(plutil -extract AvailableLibraries.0.SupportedPlatformVariant raw "${xcframework}/Info.plist")"
  build_info="$(xcrun vtool -show-build "${binary}")"

  [[ "${variant}" == "maccatalyst" ]]
  [[ "$(lipo -archs "${binary}")" == "arm64" ]]
  grep -q 'platform MACCATALYST' <<< "${build_info}"
}

for command in ar awk cargo cbindgen git grep lipo plutil python3 rustup xcrun; do
  require_command "${command}"
done

clone_if_missing https://github.com/signalapp/ringrtc.git "${RINGRTC_DIR}" \
  --branch "${RINGRTC_TAG}" --depth 1
verify_commit "${RINGRTC_DIR}" "${RINGRTC_COMMIT}"

if git -C "${RINGRTC_DIR}" apply --check "${RINGRTC_PATCH}"; then
  git -C "${RINGRTC_DIR}" apply "${RINGRTC_PATCH}"
elif ! git -C "${RINGRTC_DIR}" apply --reverse --check "${RINGRTC_PATCH}"; then
  echo "error: the Catalyst patch does not apply cleanly to ${RINGRTC_DIR}" >&2
  exit 1
fi

if [[ ! -d "${WEBRTC_SRC_DIR}/.git" ]]; then
  clone_if_missing https://chromium.googlesource.com/chromium/tools/depot_tools.git \
    "${DEPOT_TOOLS_DIR}"
  env PATH="${DEPOT_TOOLS_DIR}:${PATH}" "${RINGRTC_DIR}/bin/prepare-workspace" ios
fi
verify_commit "${WEBRTC_SRC_DIR}" "${WEBRTC_COMMIT}"

readonly RUST_TOOLCHAIN="$(tr -d '[:space:]' < "${RINGRTC_DIR}/rust-toolchain")"
rustup toolchain install "${RUST_TOOLCHAIN}" --profile minimal
rustup target add --toolchain "${RUST_TOOLCHAIN}" "${RUST_TARGET}"
rustup component add --toolchain "${RUST_TOOLCHAIN}" rust-src

echo "Building WebRTC ${WEBRTC_VERSION} for Apple Silicon Catalyst"
env PATH="${DEPOT_TOOLS_DIR}:${PATH}" \
  python3 "${WEBRTC_SRC_DIR}/tools_webrtc/ios/build_ios_libs.py" \
    -o "${WEBRTC_BUILD_DIR}" \
    --build_config release \
    --arch catalyst:arm64 \
    --deployment-target "${DEPLOYMENT_TARGET}" \
    --extra-gn-args \
      rtc_build_examples=false \
      rtc_build_tools=false \
      rtc_include_tests=false \
      rtc_enable_protobuf=false \
      rtc_enable_sctp=false \
      rtc_libvpx_build_vp9=true \
      rtc_disable_metrics=true \
      rtc_disable_trace_events=true \
      rtc_opus_support_dred=true \
      use_lld=false

echo "Building RingRTC ${RINGRTC_TAG} for Apple Silicon Catalyst"
(
  cd "${RINGRTC_DIR}/src/rust"
  env IPHONEOS_DEPLOYMENT_TARGET="${DEPLOYMENT_TARGET}" \
    cargo "+${RUST_TOOLCHAIN}" rustc \
      --target "${RUST_TARGET}" \
      --release \
      --crate-type staticlib
)

rm -rf "${OUTPUT_DIR}/WebRTC.xcframework"
mkdir -p "${OUTPUT_DIR}/libringrtc/${RUST_TARGET}"
cp -R "${WEBRTC_BUILD_DIR}/WebRTC.xcframework" "${OUTPUT_DIR}/WebRTC.xcframework"
cp "${RINGRTC_DIR}/target/${RUST_TARGET}/release/libringrtc.a" \
  "${OUTPUT_DIR}/libringrtc/${RUST_TARGET}/libringrtc.a"

cbindgen "${RINGRTC_DIR}/src/rust/src/lib.rs" \
  --config "${RINGRTC_DIR}/src/rust/cbindgen.toml" \
  -o "${OUTPUT_DIR}/libringrtc/ringrtc.h"

"${RINGRTC_DIR}/bin/convert_webrtc_acknowledgments.py" -f plist \
  "${OUTPUT_DIR}/WebRTC.xcframework/LICENSE.md" \
  > "${OUTPUT_DIR}/acknowledgments-webrtc-ios.plist"

validate_framework "${OUTPUT_DIR}/WebRTC.xcframework"
validate_archive "${OUTPUT_DIR}/libringrtc/${RUST_TARGET}/libringrtc.a"

echo
echo "Validated Apple Silicon Catalyst artifacts in ${OUTPUT_DIR}."
echo "Run the following from ${REPO_ROOT}:"
echo "  LIBSIGNAL_LOCAL_PATH=${CHECKOUT_ROOT}/libsignal RINGRTC_LOCAL_PATH=${RINGRTC_DIR} bundle exec pod install"
